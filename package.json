    "vite-plugin-monkey": "^8.1.1"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.71",
    "ramda": "^0.32.0",
    "sanitize-filename": "^1.6.5",
    "turndown": "^7.2.5"
  }
}
